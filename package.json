{
  "name": "slideschurch",
  "version": "0.3.0",
  "private": true,
  "description": "Deck-as-data slide engine. Decks are deck.json + brief.md; HTML is generated from pluggable design packs (designs/*).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "designs": "tsx cli/designs.ts",
    "new": "tsx cli/new.ts",
    "new:design": "tsx cli/new-design.ts",
    "validate": "tsx cli/validate.ts",
    "build": "tsx cli/build.ts",
    "lint": "tsx cli/validate.ts --all",
    "schemas": "tsx cli/schemas.ts",
    "export:pptx": "tsx cli/export-pptx.ts",
    "export:pdf": "tsx cli/export-pdf.ts",
    "import:pptx": "tsx cli/import-pptx.ts",
    "build:presenter": "vite build",
    "serve": "tsx cli/serve.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "slides",
    "presentation",
    "deck",
    "design-system"
  ],
  "author": "Francisco J. Seva",
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
