exports[`render > layout markup (snapshots) > closing 1`] = `
"<section class="slide slide--closing" data-layout="closing" data-slide-id="closing" data-screen-label="11 Closing" data-variant="monastic" data-palette="ordinary" data-enter="fade-lift">
<div class="closing"><div class="ornament ornament--lg" aria-hidden="true" data-motif="cross"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M50 16 L50 84 M28 38 L72 38"/></svg></div><p class="kicker">BENDICIÓN</p><p class="blessing">«El Señor os bendiga y os guarde;<br/>haga resplandecer su rostro sobre vosotros<br/>y os conceda su paz.»</p><p class="amen">Amén.</p></div>
</section>"
`;

exports[`render > layout markup (snapshots) > cover 1`] = `
"<section class="slide slide--cover" data-layout="cover" data-slide-id="cover" data-screen-label="01 Cover" data-variant="festive" data-palette="ordinary" data-enter="fade-lift">
<div class="cover"><p class="kicker">CURSO DE CATEQUESIS</p><p class="lead">Confirmación de Adultos</p><div class="ornament ornament--lg" aria-hidden="true" data-motif="cross"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M50 16 L50 84 M28 38 L72 38"/></svg></div><h1 class="title title--hero">Creo en Dios</h1><p class="subtitle">Padre todopoderoso</p><p class="citation">CEC 198-421</p><p class="invocation">En el nombre del Padre, y del Hijo, y del Espíritu Santo. Amén.</p></div>
</section>"
`;

exports[`render > layout markup (snapshots) > divider 1`] = `
"<section class="slide slide--divider" data-layout="divider" data-slide-id="divider" data-screen-label="09 Divider" data-variant="monastic" data-palette="ordinary" data-enter="fade-lift">
<div class="divider"><div class="ornament ornament--lg" aria-hidden="true" data-motif="compass"><svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="50" cy="50" r="32" stroke-width="0.8"/><circle cx="50" cy="50" r="22" stroke-width="0.6"/><path d="M50 18 L55 50 L50 82 L45 50 Z"/><path d="M18 50 L50 45 L82 50 L50 55 Z"/><path d="M50 18 L50 82 M18 50 L82 50"/></svg></div><p class="kicker">SEGUNDA PARTE</p><h2 class="title title--medium">La Providencia</h2><hr class="rule"/><p class="subtitle">Dios sostiene y guía su creación</p></div>
</section>"
