exports[`render > layout markup (snapshots) > summary 1`] = `
"<section class="slide slide--summary" data-layout="summary" data-slide-id="summary" data-screen-label="08 Summary" data-variant="monastic" data-palette="ordinary" data-enter="fade-lift" data-steps>
<div class="frame"><p class="kicker">EN RESUMEN</p><h2 class="title">Lo que confesamos</h2><hr class="rule"/><ol class="points points--arabic"><li data-step=""><span class="points__marker">1.</span><span class="points__text">Dios Padre es el principio sin principio de todas las cosas.</span></li><li data-step=""><span class="points__marker">2.</span><span class="points__text">Crea por amor, no por necesidad.</span></li><li data-step=""><span class="points__marker">3.</span><span class="points__text">Su providencia sostiene lo creado hacia su plenitud.</span></li></ol><p class="citation">CEC 279-324</p></div>
</section>"
`;
